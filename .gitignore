# ===== 依赖 =====
node_modules/
.venv/
venv/
__pycache__/

# ===== 后端运行期文件 =====
# 临时数据集 Session（含用户上传数据副本与 metadata），禁止入库
backend/runtime/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ===== 构建产物 =====
dist/
build/
*.log
*.tsbuildinfo

# ===== 环境变量与配置 =====
.env
.env.local
.env.*.local

# ===== IDE / 系统 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ===== 数据文件 =====
# 用户上传/生成的业务数据默认不入库，仅保留下方示例文件
*.xlsx
data/*
!data/
!data/sample/
data/sample/*
!data/sample/demo.csv
!data/sample/ml_demo.csv

# local verification files
backend/_verify_*.py
backend/_analyze_*.ps1
backend/_analyze_*.json
backend/_a_probe.json
backend/_uvicorn_*.log*
