# ===== 复制本文件为 .env 后按需修改 =====
# 注意：.env 已被 .gitignore 忽略，请勿提交真实配置。

# --- 后端 FastAPI ---
# 服务监听主机与端口
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 允许跨域访问的前端地址（多个用英文逗号分隔）
BACKEND_CORS_ORIGINS=http://localhost:5173

# 数据上传大小上限（MB）
DATA_MAX_UPLOAD_MB=20

# --- Dataset Session（临时数据集会话）---
# Session 有效时长（分钟），默认 120 分钟（2 小时）。无后台定时任务，访问/上传时惰性清理
DATASET_SESSION_TTL_MINUTES=120

# 会话数据根目录（默认 backend/runtime/datasets，已 .gitignore 忽略；可用绝对路径覆盖）
# DATASET_RUNTIME_DIR=D:/ai/AI-Data-Platform/backend/runtime/datasets

# --- 前端 Vite ---
# Vite 开发服务器将 /api 代理到该后端地址
# 建议使用 127.0.0.1，避免 localhost 被解析为 IPv6(::1) 而后端只监听 IPv4 导致 502
VITE_PROXY_TARGET=http://127.0.0.1:8000
